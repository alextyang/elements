{
  "schemaVersion": 1,
  "taxonomy": {
    "provider": "WMO International Cloud Atlas",
    "classificationUrl": "https://cloudatlas.wmo.int/cloud-classification-summary.html",
    "associatedFormsUrl": "https://cloudatlas.wmo.int/en/Associated-cloud-forms-table.html"
  },
  "strictReadiness": {
    "minimumTransportUpdates": 64,
    "minimumHistoryAcceptanceFraction": 0.9,
    "minimumStableHistoryAge": 0.75,
    "minimumPersistentHistoryConfidence": 0.85,
    "minimumProjectedOpacity": 0.00001,
    "requireWebGpu": true,
    "requireCurrentCaseEvidence": true,
    "requireCompleteLightVolume": true,
    "requireFiniteTransport": true,
    "requireHistoryValid": true,
    "requireReconstructionMaturity": true,
    "allowEmptyFrame": false
  },
  "invariants": [
    {
      "id": "finite-world-support",
      "domain": "formation",
      "observable": "Cloud systems have physically generated, irregular world-space termini and do not continue as a canvas-wide band unless the meteorological state is a true immediate overcast.",
      "rejects": ["screen-space-mask", "uniform-alpha-fade", "rectangular-support", "camera-locked-clouds"]
    },
    {
      "id": "aperiodic-organization",
      "domain": "formation",
      "observable": "Repeated elements share meteorological organization while varying spacing, scale, phase, merger, erosion, and orientation across several nested scales.",
      "rejects": ["fake-grid", "repeated-stamp", "equal-lobe-spacing", "periodic-domain"]
    },
    {
      "id": "genus-angular-scale",
      "domain": "morphology",
      "observable": "Element angular size, vertical extent, base altitude, and horizon foreshortening identify the WMO genus at every qualified camera perspective.",
      "rejects": ["wrong-scale-hierarchy", "camera-independent-scale", "miniature-storm", "oversized-high-cloud"]
    },
    {
      "id": "connected-parent-topology",
      "domain": "morphology",
      "observable": "Turrets, anvils, accessories, and supplementary features remain causally and spatially attached to their owning cloud where WMO morphology requires attachment.",
      "rejects": ["detached-owner-feature", "floating-anvil", "pasted-accessory", "broken-updraft-core"]
    },
    {
      "id": "coherent-condensation-base",
      "domain": "morphology",
      "observable": "Liquid convective elements share a meteorologically credible condensation level while entrained fragments and precipitation-driven scud may occupy distinct lower levels.",
      "rejects": ["random-puff-altitudes", "spherical-blob-field", "unmotivated-low-density", "flat-bottom-stamp"]
    },
    {
      "id": "phase-appropriate-boundary",
      "domain": "morphology",
      "observable": "Liquid edges show nested cauliflower, erosion, and entrainment; ice edges show fibres, shear, and sedimentation; stratiform edges show correlated sheets, holes, and ragged humid-air fragments.",
      "rejects": ["smooth-oval", "cotton-cirrus", "hard-rim", "uniform-noise-edge"]
    },
    {
      "id": "volumetric-negative-space",
      "domain": "morphology",
      "observable": "Gaps, cavum, lacunae, and clear-air channels remove condensate through physical depth and exhibit parallax, occlusion, and irregular condensate rims.",
      "rejects": ["alpha-hole", "painted-gap", "identical-perforations", "boundary-clipping"]
    },
    {
      "id": "neutral-passive-extinction",
      "domain": "transport",
      "observable": "Passive cloud extinction is spectrally neutral; chromatic appearance comes from incident sky, solar or lunar radiance, phase, and atmospheric path rather than RGB transmittance tint.",
      "rejects": ["colored-transmittance", "channel-dependent-extinction", "cyan-shadow-filter"],
      "metric": {
        "name": "maximumTransmittanceChroma",
        "operator": "less-than-or-equal",
        "value": 0.025
      }
    },
    {
      "id": "atmosphere-coupled-radiance",
      "domain": "lighting",
      "observable": "Cloud highlights, shadows, transmitted sky, haze, and distant extinction inhabit the same solar, lunar, aerosol, humidity, ozone, and exposure state as the surrounding sky.",
      "rejects": ["atmosphere-color-mismatch", "white-overlay", "luminous-night-cloud", "isolated-color-grade"]
    },
    {
      "id": "bounded-source-scattering",
      "domain": "lighting",
      "observable": "Silver lining and forward scattering follow source angle, droplet or ice phase, and finite optical path without a fixed screen-space rim or blown circular bloom.",
      "rejects": ["fixed-edge-glow", "uniform-silver-lining", "solar-stamp", "unbounded-forward-lobe"]
    },
    {
      "id": "aerial-perspective-continuity",
      "domain": "lighting",
      "observable": "Distance changes contrast, hue, extinction, and apparent scale continuously through the atmosphere while nearby clouds retain greater local relief.",
      "rejects": ["uniform-distance-whitening", "layer-seam", "depth-invariant-contrast", "flat-composite"]
    },
    {
      "id": "multiple-scattering-shadow-depth",
      "domain": "lighting",
      "observable": "Dense cloud interiors and undersides remain structured by source visibility, sky irradiance, ground bounce, and multiple scattering without black crushing or ambient-white fill.",
      "rejects": ["black-interior", "flat-grey-deck", "ambient-white-cloud", "single-scatter-cardboard"]
    },
    {
      "id": "lifecycle-structure",
      "domain": "evolution",
      "observable": "Incipient, growing, mature, precipitating, and decaying states differ in connected core, turret age, glaciation, precipitation, detrainment, and erosion rather than opacity alone.",
      "rejects": ["opacity-only-lifecycle", "simultaneous-incompatible-stages", "detached-detrainment", "frozen-repeated-form"]
    },
    {
      "id": "hydrometeor-parent-depth-order",
      "domain": "weather",
      "observable": "Virga, rain, snow, hail, and pannus originate in an admissible parent layer and remain depth ordered through cloud, precipitation shaft, wet haze, and foreground atmosphere.",
      "rejects": ["detached-precipitation", "frontmost-rain-overlay", "uniform-rain-curtain", "dry-air-pannus"]
    },
    {
      "id": "multilayer-parallax-ordering",
      "domain": "weather",
      "observable": "Independent layers retain altitude-dependent element scale, parallax, wind, phase, occlusion, and extinction; mother-cloud lineages preserve causal attachment.",
      "rejects": ["duplicated-layer-texture", "impossible-layer-order", "shared-rigid-motion", "missing-cross-layer-extinction"]
    },
    {
      "id": "surface-obscuration-continuity",
      "domain": "weather",
      "observable": "Fog, mist, ice fog, and diamond dust arise in a finite boundary-layer depth with correct visibility, surface contact, phase, and smooth transition into clear air and sky radiance.",
      "rejects": ["full-screen-white-filter", "floating-fog-plane", "hard-visibility-boundary", "wrong-phase-sparkle"]
    },
    {
      "id": "upper-atmosphere-altitude-lighting",
      "domain": "weather",
      "observable": "Polar stratospheric and noctilucent clouds occupy their physical altitude and season, receiving grazing sunlight above a darker lower atmosphere with restrained view-dependent color.",
      "rejects": ["tropospheric-placement", "baked-iridescence", "luminous-overlay", "wrong-solar-depression"]
    }
  ],
