{
  "name": "elements",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test scripts/test-*.mjs",
    "sky:curate": "node scripts/curate-sky-benchmark.mjs && node scripts/curate-eye2sky-night.mjs && node scripts/assemble-sky-benchmark.mjs",
    "moon:curate": "node scripts/curate-moon-benchmark.mjs && node scripts/curate-eye2sky-night.mjs && node scripts/curate-nasa-lunar-truth.mjs && node scripts/curate-commons-moon.mjs && node scripts/normalize-moon-benchmark.mjs",
    "moon:render": "bash scripts/render-sky-benchmark.sh",
    "moon:analyze": "node scripts/analyze-sky-benchmark.mjs",
    "sky:render": "bash scripts/render-sky-photographs.sh",
    "sky:analyze": "node scripts/analyze-sky-benchmark.mjs",
    "sky:noise": "node scripts/generate-cloud-noise-assets.mjs && node scripts/generate-cloud-volume-atlas.mjs && node scripts/generate-cloud-optics-assets.mjs && node scripts/generate-blue-noise-asset.mjs",
    "sky:cloud-atlas": "node scripts/generate-cloud-volume-atlas.mjs",
    "sky:cloud-optics": "node scripts/generate-cloud-optics-assets.mjs",
    "sky:validate-webgpu": "node scripts/validate-webgpu-shaders.mjs",
    "sky:test-weather-transport": "node scripts/test-specialized-weather-transport.mjs && node scripts/test-ordered-weather-atmosphere-transport.mjs && node scripts/test-hydrometeor-system.mjs",
    "cloud:review": "bash scripts/review-cloud-render.sh",
    "cloud:review:plan": "node scripts/cloud-photographic-review-queue.mjs plan --profile next",
    "cloud:review:queue": "node scripts/cloud-photographic-review-queue.mjs run --profile next",
    "cloud:previews:generate": "node scripts/run-cloud-preview-generation.mjs",
    "cloud:previews:regenerate": "node scripts/run-cloud-preview-generation.mjs --force",
    "cloud:previews:generate:headless": "node scripts/run-cloud-preview-generation.mjs --capture-mode headless",
    "cloud:previews:generate:external": "node scripts/generate-cloud-previews.mjs",
    "cloud:previews:serve": "node scripts/serve-cloud-preview-matrix.mjs",
    "cloud:previews:watch": "node scripts/watch-cloud-previews.mjs",
    "cloud:previews:watch:external": "node scripts/watch-cloud-previews.mjs --external-server",
    "cloud:previews:watch:start": "node scripts/manage-cloud-preview-watch.mjs start",
    "cloud:previews:watch:status": "node scripts/manage-cloud-preview-watch.mjs status",
    "cloud:previews:watch:stop": "node scripts/manage-cloud-preview-watch.mjs stop",
    "cloud:previews:watch:restart": "node scripts/manage-cloud-preview-watch.mjs restart",
    "cloud:diagnostics": "node scripts/capture-cloud-diagnostics.mjs",
    "sky:qualify": "bash scripts/qualify-cloud-renderer.sh"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.2",
    "next": "15.5.21",
    "normalize.css": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "sharp": "^0.34.3",
    "typescript": "^5",
    "tz-lookup": "^6.1.25"
  }
}
