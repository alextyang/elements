{
  "browser": {
    "launchOptions": {
      "headless": true,
      "args": [
        "--enable-unsafe-webgpu",
        "--enable-features=WebGPU",
        "--disable-background-timer-throttling",
        "--disable-renderer-backgrounding"
      ]
    },
    "contextOptions": {
      "viewport": {
        "width": 800,
        "height": 500
      }
    }
  }
}
